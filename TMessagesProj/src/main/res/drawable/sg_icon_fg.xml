<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- one simplified paper plane, nose to the left; the notch in its tail
         is the "V": it lives in the outline, there is no separate letter -->
    <path android:pathData="M22,54 L84,30 L50,54 L84,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="30"
                android:endX="84"
                android:endY="78"
                android:startColor="#F4F7FB"
                android:centerColor="#DCE4EF"
                android:endColor="#A9B7CA" />
        </aapt:attr>
    </path>

    <!-- folded underside: gives the plane depth, keeps it one shape -->
    <path
        android:pathData="M22,54 L50,54 L84,78 Z"
        android:fillColor="#5E6B7E" />
</vector>